FROM texlive/texlive:latest-medium

ARG UID=1000
ARG GID=1000
ARG UNAME=dev

RUN if ! getent passwd ${UID} >/dev/null; then \
      groupadd -g ${GID} ${UNAME} || true; \
      useradd -m -u ${UID} -g ${GID} -s /bin/bash ${UNAME}; \
    fi

ENV HOME=/tmp
USER ${UID}

WORKDIR /workspace

CMD ["bash"]
